# Optional. Relays the extension reads from and writes to, comma separated.
# Put your own relay first; it is the anchor that never prunes.
# Leave unset to use the public defaults in lib/nostr/config.js.
HYPERCHAT_RELAYS=

# Optional. API key for api.hlnames.xyz, used to verify that a trader really owns
# the .hl name on their messages. Without it names fall back to addresses.
# This ships inside the extension, so treat it as public and rate-limited.
HLNAMES_API_KEY=
