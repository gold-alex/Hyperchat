{
  "name": "HyperChat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:proto": "pbjs -t static-module -w es6 -p lib lib/chat-message.proto > lib/chat-message.js && node scripts/postprocess-proto.js",
    "build": "pnpm build:proto && wxt build",
    "dev:ext": "wxt dev",
    "poc:session": "tsx scripts/proof-of-concept.ts",
    "preview": "wxt build",
    "zip": "wxt zip",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .output coverage dist",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "nwaku:debug": "node scripts/nwaku-debug.js",
    "nwaku:seed": "node scripts/nwaku-seed.js"
  },
  "dependencies": {
