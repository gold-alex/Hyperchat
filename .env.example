VITE_WAKU_NODE_URI=localhost
VITE_WAKU_NODE_PORT=443
VITE_WAKU_NODE_PEER_ID=PEER_ID
# Optional ordered bootstrap peer list (comma/newline-delimited multiaddrs).
# When set, this takes precedence over VITE_WAKU_NODE_URI/PORT/PEER_ID.
# Example:
# VITE_WAKU_BOOTSTRAP_PEERS=/dns4/nwaku-a.example.com/tcp/443/wss/p2p/12D3Koo...,/dns4/nwaku-b.example.com/tcp/443/wss/p2p/12D3Koo...
VITE_WAKU_BOOTSTRAP_PEERS=
# Secure transport policy: remote gateways should use https:// (http:// allowed for localhost/loopback only).
VITE_LIGHTPUSH_GATEWAY_URL=http://localhost:8787
# Optional dev-only escape hatch: force legacy protobuf mode in the client.
# Default is strict auth-lite (fail closed if gateway URL is missing).
VITE_WAKU_USE_LEGACY_PROTO=false
# Optional HL Names client key. This runs in browser client code and is not secret.
# Leave empty to make keyless requests.
VITE_HLNAMES_API_KEY=

# Gateway SIWE enforcement (secure defaults):
# Set expected SIWE domain and chain for gateway session validation.
LP_DOMAIN=localhost
LP_CHAIN_ID=1
# Deployment context for gateway startup policy (recommended explicit values: local | production | staging).
# Conservative default is non-local when omitted.
LP_DEPLOYMENT_CONTEXT=local
# Local-only escape hatch: set true to allow startup without LP_DOMAIN/LP_CHAIN_ID.
# WARNING: This weakens SIWE origin/chain binding guarantees.
LP_ALLOW_INSECURE_SIWE_ENV=false
