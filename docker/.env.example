# Waku Node Configuration
# Copy this file to .env and fill in your values

# ============================================
# PRODUCTION Configuration (with Caddy proxy)
# ============================================

# Your server's public IP address
PUBLIC_IP=

# Domain for WebSocket connections (e.g., waku.yourdomain.com)
WAKU_WSS_DOMAIN=

# Domain for REST API (e.g., waku-api.yourdomain.com)
WAKU_API_DOMAIN=

# Node private key (generate with: openssl rand -hex 32)
NODE_KEY=


# ============================================
# LOCAL TESTING Configuration
# ============================================

# Base ports and storage paths for the primary LightPush/Filter/Store node.
# Override only if you have conflicts.
WAKU_WS_PORT=8000
WAKU_REST_PORT=8645
# Security defaults: keep REST API on localhost unless you intentionally expose it.
WAKU_REST_BIND_HOST=127.0.0.1
# Security defaults: keep admin endpoints disabled unless explicitly required.
WAKU_REST_ADMIN=false
WAKU_DB_PATH=./nwaku_test_db
NWAKU_IP=172.28.0.10

# Optional helper relay peer that keeps LightPush publishing locally.
# Copy PRIMARY_WAKU_PEER_ID from the primary node's PeerID output.
PRIMARY_WAKU_PEER_ID=
WAKU_RELAY_WS_PORT=8100
WAKU_RELAY_REST_PORT=8745
# Security defaults mirror primary node for relay REST/admin.
WAKU_RELAY_REST_BIND_HOST=127.0.0.1
WAKU_RELAY_REST_ADMIN=false
WAKU_RELAY_DB_PATH=./nwaku_relay_test_db
NWAKU_RELAY_IP=172.28.0.11
# (Optional) Record the relay peer id after first boot for reference.
WAKU_RELAY_PEER_ID=

# After starting the test node, get the Peer ID with:
# docker logs nwaku-test 2>&1 | grep "PeerID"
# OR
# curl http://localhost:8645/debug/v1/info | jq -r '.enrUri' | cut -d'/' -f7

# Then add to your project root .env file:
# VITE_WAKU_NODE_URI=localhost
# VITE_WAKU_NODE_PORT=8000
# VITE_WAKU_NODE_PEER_ID=<peer_id_from_above>
# PRIMARY_WAKU_PEER_ID=<same_peer_id>

# ============================================
# Lightpush Gateway (local docker)
# ============================================
LP_GATEWAY_PORT=8787
LP_GATEWAY_IP=172.28.0.12
# If unset, compose defaults to http://nwaku:8645
# LP_RPC_HTTP=http://nwaku:8645
# Optional publish transport override: auto | lightpush | rpc
# LP_PUBLISH_TRANSPORT=auto
# Optional LightPush routing settings (defaults to PRIMARY_WAKU_PEER_ID and ws://<LP_RPC_HTTP host>:8000)
# LP_WAKU_PEER_ID=${PRIMARY_WAKU_PEER_ID}
# LP_WAKU_WS_URL=ws://nwaku:8000
# Maximum decoded payload bytes accepted by POST /message (default in server: 32768)
# LP_MAX_MESSAGE_PAYLOAD_BYTES=32768
# Optional bounded in-memory store controls (defaults shown)
# LP_SESSION_STORE_MAX_ENTRIES=5000
# LP_NONCE_STORE_MAX_ENTRIES=10000
# LP_RATE_LIMIT_MAX_ENTRIES=20000
# LP_MESSAGE_DEDUPER_MAX_ENTRIES=20000
# LP_BALANCE_CACHE_MAX_ENTRIES=10000
